# 出勤打卡系統 — 環境變數範例
# 複製為 .env 後依需要修改（.env 不可 commit）

# development | production
APP_ENV=development

# 開發預設：本機 SQLite（留空或省略則自動使用 data/attendance.sqlite3）
# DATABASE_URL=sqlite:///D:/出勤打卡系統/data/attendance.sqlite3
DATABASE_URL=

# 未來 PostgreSQL 範例（本階段不要連線）：
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/attendance

# JWT 簽章（正式環境 APP_ENV=production 時必填）
# 開發可省略：將使用／自動建立 data/.secret_key
SECRET_KEY=

# 相容舊名（可選）
# ATTENDANCE_SECRET_KEY=

# CORS：逗號分隔，禁止 *
CORS_ORIGINS=http://127.0.0.1:8800,http://localhost:8800

# JWT 有效分鐘數（預設 7 天；閒置登出另由前端 + logout 撤銷）
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 無操作自動登出（分鐘）；與前端倒數對齊
IDLE_TIMEOUT_MINUTES=3

# 業務時區（打卡／排班／報表）
APP_TIMEZONE=Asia/Taipei

# 本機 uvicorn 綁定（非前端 API_BASE）
HOST=0.0.0.0
PORT=8800

# Excel 預覽快取：memory（本機）| postgres（Cloud 多實例）
PREVIEW_STORE=memory

# GitHub Pages 準備腳本用（公網 API 根網址，非密鑰）
# ATTENDANCE_API_BASE=https://your-api.example.com
